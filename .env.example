# Copy to .env and fill in. Real values are shared out-of-band, never committed.

# Postgres with PostGIS. Hosted (Neon or Supabase) so the whole team shares one
# database. Note the +psycopg driver suffix and sslmode=require for hosted
# instances — a plain postgresql:// URL will try psycopg2, which is not installed.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Separate database holding only fabricated incidents for the /demo screen.
# Seed it with: python -m ecoguard.scripts.seed_demo
DEMO_DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Risk analysis and response planning
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Israel Meteorological Service wind observations. Keep the token secret.
IMS_API_TOKEN=

# Air Pollution v1 deterministic screening policy. These values control a
# possible-transport geometry; they are not plume-physics constants.
AIR_POLLUTION_TRANSPORT_SCREENING_ENABLED=true
AIR_POLLUTION_TRANSPORT_HALF_ANGLE_DEG=45
AIR_POLLUTION_TRANSPORT_MAX_DISTANCE_M=10000
AIR_POLLUTION_TRANSPORT_ARC_SEGMENT_COUNT=8
AIR_POLLUTION_WIND_MAX_AGE_MINUTES=30
AIR_POLLUTION_TRANSPORT_MIN_WIND_SPEED_MPS=0.5

# NASA FIRMS MAP_KEY — https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=

# Israel Water Authority / Hydrological Service.
WATER_AUTHORITY_BASE_URL=https://hydro.water.gov.il

# IMS radar uses NTLM login. Use the same username format as the browser login
# (for example DOMAIN\\username when a domain is required). The optional cookie
# carries the provider's web-security session and may need periodic refresh.
IMS_RADAR_USERNAME=
IMS_RADAR_PASSWORD=
IMS_RADAR_COOKIE=

# Telegram, from https://my.telegram.org. Bootstrap the external session and
# discover stable peer IDs with:
# python -m ecoguard.collection.shared.telegram.listener --discover
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Verified numeric peer pins. Overrides must equal the canonical policy values;
# a changed username/peer mapping is rejected rather than silently trusted.
TELEGRAM_PEER_ID_ISRAEL_POLICE_100=-1002843129862
TELEGRAM_PEER_ID_ATANPOLICE=-1001581748447
TELEGRAM_PEER_ID_MDAISRAEL=-1001177174722
TELEGRAM_PEER_ID_FIREISRAEL7777=-1001411503185
# Flood changes faster than Fire, so it has its own explicit matching window.
TELEGRAM_FLOOD_CORROBORATION_WINDOW_MINUTES=90

# Nominatim geocoding. The user agent must identify the project — Nominatim
# blocks unidentified clients.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=EcoGuard-Agents/1.0 (your-email@example.com)

# Dedicated backend token for Mapbox Matrix and Directions APIs. Do not reuse
# the browser's VITE_MAPBOX_KEY so backend usage can be tracked separately.
MAPBOX_ACCESS_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
MAPBOX_ROUTING_PROFILE=mapbox/driving-traffic
MAPBOX_ROUTING_TIMEOUT_SECONDS=5
MAPBOX_MATRIX_MAX_SOURCES=9
MAPBOX_EVENT_ROAD_TOLERANCE_M=100

# Flood road targeting. The first station-only lookup stays tight; it expands
# to the detector's declared location precision only when no road is found.
FLOOD_ROAD_PRIMARY_RADIUS_M=30
FLOOD_ROAD_MAXIMUM_RADIUS_M=250
FLOOD_MAPBOX_VERIFICATION_RADIUS_M=50
FLOOD_ROAD_DUPLICATE_DISTANCE_M=75

# Set to 1 to expose POST /api/dev/run/{source}. Never set in production.
ECOGUARD_DEV_ENDPOINTS=
